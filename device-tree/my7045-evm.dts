	reserved-memory {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges;
	};

	leds {
		compatible = "gpio-leds";

		led0 {
			label = "heartbeat";
			gpios = <0xe 0xe 0x0>;
			linux,default-trigger = "heartbeat";
		};

		led1 {
			label = "disc";
			gpios = <0xe 0xf 0x0>;
			linux,default-trigger = "mmc1";
		};

		led2 {
			label = "user-led0";
			gpios = <0xe 0x9 0x0>;
			default-state = "on";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		autorepeat;

		user_key@0 {
			label = "user-key0";
			gpios = <0xe 0x10 0x1>;
			linux,code = <0x94>;
			debounce-interval = <0x0>;
		};
	};

